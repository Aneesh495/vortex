<Project Sdk="Gsharp.NET.Sdk/0.5.212">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vortex.Replication</RootNamespace>
    <PackageId>Vortex.Replication</PackageId>
    <Authors>Aneesh Parthasarathy</Authors>
    <Description>In-Sync Replicas (ISR) protocol, Raft consensus metadata engine, and failure detector for Vortex.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.gsproj" />
    <ProjectReference Include="..\Vortex.Storage\Vortex.Storage.gsproj" />
    <ProjectReference Include="..\Vortex.Native\Vortex.Native.csproj" />
  </ItemGroup>

</Project>
