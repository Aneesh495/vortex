<Project Sdk="Gsharp.NET.Sdk/0.5.212">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vortex.Coordination</RootNamespace>
    <PackageId>Vortex.Coordination</PackageId>
    <Authors>Aneesh Parthasarathy</Authors>
    <Description>Consumer group coordination, cooperative sticky rebalance protocols, and __consumer_offsets commit store for Vortex.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.gsproj" />
    <ProjectReference Include="..\Vortex.Storage\Vortex.Storage.gsproj" />
    <ProjectReference Include="..\Vortex.Native\Vortex.Native.csproj" />
  </ItemGroup>

</Project>
