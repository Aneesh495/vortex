<Project Sdk="Gsharp.NET.Sdk/0.5.212">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Vortex.Server</PackageId>
    <Version>0.1.0</Version>
    <Authors>Aneesh Krishna</Authors>
    <Description>Distributed stream processing broker daemon, partition manager, Raft consensus host, and embedded HTTP telemetry server for Vortex.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.gsproj" />
    <ProjectReference Include="..\Vortex.Storage\Vortex.Storage.gsproj" />
    <ProjectReference Include="..\Vortex.Replication\Vortex.Replication.gsproj" />
    <ProjectReference Include="..\Vortex.Network\Vortex.Network.gsproj" />
    <ProjectReference Include="..\Vortex.Coordination\Vortex.Coordination.gsproj" />
    <ProjectReference Include="..\Vortex.Schema\Vortex.Schema.gsproj" />
  </ItemGroup>

</Project>
