<Project Sdk="Gsharp.NET.Sdk/0.5.212">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Vortex.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>Aneesh Krishna</Authors>
    <Description>High performance client library for Vortex streaming clusters with automatic batching, retry policies, and cooperative consumer groups.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.gsproj" />
    <ProjectReference Include="..\Vortex.Network\Vortex.Network.gsproj" />
    <ProjectReference Include="..\Vortex.Coordination\Vortex.Coordination.gsproj" />
  </ItemGroup>

</Project>
