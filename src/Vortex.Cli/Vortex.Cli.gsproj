<Project Sdk="Gsharp.NET.Sdk/0.5.212">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Vortex.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Aneesh Krishna</Authors>
    <Description>Command line interface, administration utility, and benchmarking harness for the Vortex streaming cluster.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Core\Vortex.Core.gsproj" />
    <ProjectReference Include="..\Vortex.Storage\Vortex.Storage.gsproj" />
    <ProjectReference Include="..\Vortex.Client\Vortex.Client.gsproj" />
    <ProjectReference Include="..\Vortex.Server\Vortex.Server.gsproj" />
  </ItemGroup>

</Project>
